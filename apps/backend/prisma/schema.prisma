generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IntegrationVerifyStatus {
  unverified
  success
  failed
}

enum ExceptionType {
  day_off
  custom_working_hours
}

enum RuntimeState {
  paused
  resumed
  unknown
}

enum LogSource {
  manual
  scheduler
  system
}

enum LogAction {
  pause
  resume
  verify_integration
  edit_schedule
  activate_schedule
  deactivate_schedule
  delete_schedule
  restore_schedule
  auto_delete_schedule
}

enum LogStatus {
  success
  error
}

model User {
  id           String              @id @default(uuid())
  login        String              @unique
  passwordHash String
  isActive     Boolean             @default(true)
  mustChangePassword Boolean       @default(false)
  passwordChangedAt DateTime?
  lastLoginAt   DateTime?
  failedLoginAttempts Int          @default(0)
  lockedUntil   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  sessions     UserSession[]
  integration  IntegrationSettings?
  schedules    Schedule[]
  actionLogs   ScheduleActionLog[]
}

model UserSession {
  id               String    @id @default(uuid())
  userId           String
  jti              String    @unique
  refreshTokenHash String?
  expiresAt        DateTime
  revokedAt        DateTime?
  ip               String?
  userAgent        String?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model IntegrationSettings {
  id                   String                  @id @default(uuid())
  userId               String                  @unique
  domain               String
  host                 String
  accessTokenEncrypted String
  accessTokenIv        String
  accessTokenAuthTag   String
  encryptionVersion    Int                     @default(1)
  tokenLast4           String?
  verifyStatus         IntegrationVerifyStatus @default(unverified)
  verifyMessage        String?
  verifiedAccountId    BigInt?
  verifiedAccountName  String?
  verifiedRegions      Json?
  lastVerifiedAt       DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Schedule {
  id              String              @id @default(uuid())
  userId          String
  name            String
  campaignId      BigInt
  campaignTitle   String
  campaignTimezone String             @default("Europe/Moscow")
  isEnabled       Boolean             @default(true)
  isDeleted       Boolean             @default(false)
  deletedAt       DateTime?
  purgeAt         DateTime?
  startDate       DateTime?
  endDate         DateTime?
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekdays        ScheduleWeekday[]
  workIntervals   ScheduleWorkInterval[]
  breakIntervals  ScheduleBreakInterval[]
  exceptions      ScheduleException[]
  runtimeState    ScheduleRuntimeState?
  actionLogs      ScheduleActionLog[]

  @@index([userId])
}

model ScheduleWeekday {
  id         String   @id @default(uuid())
  scheduleId String
  weekday    Int
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, weekday])
  @@index([scheduleId])
}

model ScheduleWorkInterval {
  id         String   @id @default(uuid())
  scheduleId String
  weekday    Int
  startTime  String
  endTime    String
  createdAt  DateTime @default(now())

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId])
}

model ScheduleBreakInterval {
  id         String   @id @default(uuid())
  scheduleId String
  weekday    Int
  startTime  String
  endTime    String
  label      String?
  createdAt  DateTime @default(now())

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId])
}

model ScheduleException {
  id               String        @id @default(uuid())
  scheduleId       String
  startDate        DateTime
  endDate          DateTime
  type             ExceptionType
  customStartTime  String?
  customEndTime    String?
  title            String?
  isRecurringYearly Boolean      @default(false)
  createdAt        DateTime      @default(now())

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, startDate, endDate, isRecurringYearly])
  @@index([scheduleId])
  @@index([scheduleId, startDate, endDate])
}

model ScheduleRuntimeState {
  id                 String      @id @default(uuid())
  scheduleId         String      @unique
  currentState       RuntimeState @default(unknown)
  lastDecisionReason String?
  lastTransitionAt   DateTime?
  lastCheckAt        DateTime?
  updatedAt          DateTime    @updatedAt

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
}

model ScheduleActionLog {
  id              String    @id @default(uuid())
  userId          String
  scheduleId      String?
  campaignId      BigInt
  campaignTitle   String?
  source          LogSource
  action          LogAction
  status          LogStatus
  httpStatus      Int?
  requestId       String?
  errorMessage    String?
  responsePayload Json?
  createdAt       DateTime  @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedule Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([scheduleId])
  @@index([createdAt])
}
