# Shared
TZ=Europe/Moscow

# App ports
BACKEND_PORT=8080
BACKEND_INTERNAL_PORT=4000
FRONTEND_PORT=80

# PostgreSQL
POSTGRES_DB=voximplant_scheduler
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voximplant_scheduler

# Redis
REDIS_URL=redis://redis:6379/0

# Backend
PORT=4000
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
TOKEN_ENCRYPTION_KEY=change_me_32_bytes_minimum_key
CORS_ORIGIN=http://localhost:5173
AUTH_ALLOW_PUBLIC_REGISTRATION=false

# Boot user from env (temporary mode)
BOOT_USER_LOGIN=admin
BOOT_USER_PASSWORD=admin123

# Frontend
VITE_API_BASE_URL=http://localhost:4000/api
