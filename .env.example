# Shared
TZ=Europe/Moscow

# Production ingress (Application VM)
HOST_BIND_IP=192.168.50.111
HOST_HTTP_PORT=4000

# PostgreSQL
POSTGRES_DB=voximplant_scheduler
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voximplant_scheduler

# Redis
REDIS_URL=redis://redis:6379/0

# Backend
PORT=4000
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
TOKEN_ENCRYPTION_KEY=change_me_32_bytes_minimum_key
CORS_ORIGIN=https://kit-campaign-scheduler.digital-universe.xyz
AUTH_ALLOW_PUBLIC_REGISTRATION=false

# Optional boot user. Leave both values empty unless provisioning a user.
BOOT_USER_LOGIN=
BOOT_USER_PASSWORD=
